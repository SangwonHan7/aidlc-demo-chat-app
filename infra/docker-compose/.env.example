# infra/docker-compose/.env 로 복사한 뒤 값을 채운다 (.env는 .gitignore에 의해 커밋되지 않음).
#
# NAS_HOST: NAS의 LAN IP(예: 192.168.1.50) 또는 로컬 호스트명(예: quickchat.local).
# 브라우저가 직접 접속/호출하는 주소이므로 "localhost"나 "127.0.0.1"이 아니라 실제 접속 가능한
# 주소를 넣어야 한다 - 다른 PC/모바일에서 접속할 계획이라면 특히 중요하다.
NAS_HOST=192.168.1.50

# COMPOSE_PROJECT_NAME: 반드시 고정값을 써야 한다. docker compose는 -p로 지정하지 않으면 현재
# 디렉터리 이름으로 프로젝트 이름을 정하는데, 수동 배포(예: ~/aidlc-demo-chat-app/infra/docker-compose)와
# 자동배포(~/quickchat-deploy)가 디렉터리 이름이 다르면 서로 다른 프로젝트/네트워크로 인식되어
# - 포트 충돌("address already in use", 실제로 겪은 에러)이나
# - backend가 postgres/redis/kafka 같은 서비스 이름을 못 찾는 문제로 이어진다.
# 이 값을 양쪽 .env에 동일하게 넣어두면 어느 디렉터리에서 실행하든 같은 프로젝트로 취급되어
# 컨테이너/네트워크를 공유한다.
COMPOSE_PROJECT_NAME=quickchat
